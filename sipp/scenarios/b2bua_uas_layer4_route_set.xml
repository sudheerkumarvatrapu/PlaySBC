<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<scenario name="Protocol Core Layer 4 outbound route set">
  <recv request="INVITE" crlf="true" />

  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=layer4-route-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp-b@[local_ip]:[local_port]>
      Record-Route: <sip:route-a@[local_ip]:[local_port];lr>, <sip:route-b@[local_ip]:[local_port];lr>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=layer4-route-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp-b@[local_ip]:[local_port]>
      Record-Route: <sip:route-a@[local_ip]:[local_port];lr>, <sip:route-b@[local_ip]:[local_port];lr>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp-b 53655765 2353687638 IN IP4 [local_ip]
      s=Layer 4 route set
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 8 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" crlf="true">
    <action>
      <ereg regexp="Route:.*route-b.*route-a" search_in="msg" check_it="true" assign_to="1" />
    </action>
  </recv>
  <nop><action><log message="ack-route=[$1]" /></action></nop>

  <recv request="BYE" crlf="true">
    <action>
      <ereg regexp="Route:.*route-b.*route-a" search_in="msg" check_it="true" assign_to="2" />
    </action>
  </recv>
  <nop><action><log message="bye-route=[$2]" /></action></nop>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <timewait milliseconds="1000" />
  <ResponseTimeRepartition value="10,20,50,100,150,500,1000" />
  <CallLengthRepartition value="100,250,500,1000,2000,5000" />
</scenario>
